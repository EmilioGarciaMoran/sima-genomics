# Parámetros del pipeline nuclear. Cualquier valor se puede sobrescribir con una
# variable de entorno del mismo nombre (p. ej. BUILD=hg38 bash run_all.sh).

# Ensamblaje de los BAM, del catálogo y de la referencia recortada. Tienen que coincidir:
# 01_check_inputs.py lo comprueba con la longitud de chr1 y con el alelo REF de cada posición.
BUILD=hg19

# Genotipado directo (paso 2): mismos filtros que el genotipado de los arcaicos de alta cobertura
MIN_MAPQ_DIRECT=25
MIN_BQ=20
# Ventana alrededor de cada posición para contar lecturas cercanas (pb a cada lado)
WINDOW=2000

# Verosimilitudes genotípicas (paso 3): mismos filtros que ANGSD en el manuscrito (-minMapQ 20 -minQ 20)
MIN_MAPQ_GL=20

# Bases a menos de esta distancia del extremo de la lectura se descartan en el análisis
# "sin extremos" (el daño C->T / G->A se concentra en las primeras y últimas posiciones)
END_TRIM=3

# Semilla para la elección pseudohaploide de una lectura por posición
SEED=12345

# Distancias por pares (pasos 9-10 en la nube, paso 5 aquí)
# Vectores de BAM: MAPQ mínimo y bases ignoradas en cada extremo de la lectura. El panel solo tiene
# transversiones y un alelo que no es REF ni ALT queda como N, así que el daño C->T/G->A apenas afecta:
# por eso no se recortan extremos por defecto.
PAIR_MIN_MAPQ=25
PAIR_END_TRIM=0
# Tamaño de bloque del jackknife (pb)
BLOCK_SIZE=5000000
